{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipia",
  "version": "0.2.2",
  "identifier": "local.clipia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "create": false,
        "title": "Clipia · Portapapeles con IA",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 520,
        "visible": false
      },
      {
        "label": "widget",
        "create": false,
        "focus": false,
        "title": "Clipia",
        "url": "index.html?widget",
        "width": 380,
        "height": 540,
        "minWidth": 320,
        "minHeight": 360,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRDgxMkYxNzQwMzU4MkIKUldRcldBTjA4UkxZSTY3U2I0bkxiNEZacVpYVUUvVEMxcy85UzdGbnQ4elB6d05CZkhpQ2NQZjUK",
      "endpoints": [
        "https://github.com/edwin-ortizp/clipia-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
